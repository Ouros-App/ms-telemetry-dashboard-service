APP_PORT=8000
# Infisical is optional for local development. Configure all bootstrap fields together.
INFISICAL_ENV=
INFISICAL_HOST=https://app.infisical.com
INFISICAL_PATH=
INFISICAL_PROJECT_ID=
INFISICAL_TOKEN=
PROJECT_NAME="Telemetry Dashboard Service"
LOG_LEVEL=INFO
DASHBOARD_CATALOG_PATH=data/dashboards.json

# Fluxo administrativo
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
# Opcional; por padrão usa DATABRICKS_HOST/oidc/v1/token
DATABRICKS_TOKEN_URL=

# Fluxo de dashboards dos usuários. Use o role read-only analytics_ro.
ANALYTICS_DATABASE_URL=
ANALYTICS_EXPECTED_ROLE=analytics_ro
ANALYTICS_POOL_MIN_SIZE=1
ANALYTICS_POOL_MAX_SIZE=5
ANALYTICS_COMMAND_TIMEOUT_SECONDS=8
ANALYTICS_CONNECT_TIMEOUT_SECONDS=5
ANALYTICS_RETRY_BACKOFF_SECONDS=5
# Em Discloud, o mesmo proxy SOCKS usado pelo Analytics pode alcançar o Prometheus.
ANALYTICS_SOCKS_HOST=
ANALYTICS_SOCKS_PORT=1055

# Observability do homelab. PROMETHEUS_SOCKS_HOST vazio reutiliza ANALYTICS_SOCKS_HOST.
PROMETHEUS_URL=http://192.168.15.11:9090
PROMETHEUS_SOCKS_HOST=
PROMETHEUS_SOCKS_PORT=1055
PROMETHEUS_SOCKS_CONNECT_TIMEOUT_SECONDS=5
PROMETHEUS_QUERY_TIMEOUT_SECONDS=8
PROMETHEUS_MAX_RANGE_SECONDS=604800
PROMETHEUS_MIN_STEP_SECONDS=15
PROMETHEUS_MAX_POINTS=12000

KEYCLOAK_ISSUER_URL=https://ouros-keycloak.discloud.app/realms/ouros
KEYCLOAK_AUDIENCE=ms-telemetry-dashboard-service
KEYCLOAK_JWKS_URL=https://ouros-keycloak.discloud.app/realms/ouros/protocol/openid-connect/certs
KEYCLOAK_REQUIRED_ROLE=admin
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=2
CHART_CACHE_TTL_SECONDS=30
SQL_WAIT_TIMEOUT_SECONDS=10
HTTP_RETRY_BACKOFF_SECONDS=0.1
TOKEN_REFRESH_MARGIN_SECONDS=60
# JSON array, por exemplo: ["https://frontend.example.com"]
CORS_ORIGINS=[]
